{
  "framework": "astro",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-src https://horizon-design-system-cdfi.vercel.app https://embed.figma.com https://www.figma.com"
        }
      ]
    }
  ]
}
